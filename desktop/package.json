{
  "name": "desktop",
  "productName": "Teler",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Teler Desktop: the Teler app with background folder sync",
  "author": "teler.ai <legal@teler.ai>",
  "homepage": "https://teler.ai",
  "main": "dist/main/index.cjs",
  "desktopName": "teler-desktop.desktop",
  "scripts": {
    "build": "bun scripts/build.ts",
    "start": "bun scripts/start.ts",
    "sidecar": "bun scripts/sidecar.ts",
    "smoke-sidecar": "bun scripts/smoke-sidecar.ts",
    "dist": "bun scripts/build.ts && bun scripts/sidecar.ts && bun scripts/smoke-sidecar.ts && electron-builder --publish never && bun scripts/verify-package.ts",
    "verify-package": "bun scripts/verify-package.ts",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json && node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.renderer.json && node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.1",
    "lucide-react": "^1.39.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@teler-ai/cli": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "bun-types": "1.3.14",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "happy-dom": "^20.13.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
