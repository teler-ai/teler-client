<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the standalone `teler` executable. The Bun
  runtime inside JIT-compiles JavaScript, and bun:ffi (the macOS Keychain store)
  compiles small native trampolines at run time. Bun's own signed releases carry
  these three; their dyld-environment and library-validation exceptions are left
  out because the CLI loads only system libraries.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <true/>
  </dict>
</plist>
